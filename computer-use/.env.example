# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key.

# Required. Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Virtual display size for the sandboxed desktop.
# General desktop tasks: 1024x768 or 1280x720
# Web applications:      1280x800 or 1366x768
# Avoid going above 1920x1080 - click accuracy drops and screenshots cost more tokens.
WIDTH=1280
HEIGHT=800

# Optional. Where the demo stores its settings and custom system prompt.
# Defaults to ~/.anthropic
#ANTHROPIC_CONFIG_DIR=/absolute/path/to/config
